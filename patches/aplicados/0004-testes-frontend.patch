diff --git a/tests/test_ui_admin_page.py b/tests/test_ui_admin_page.py
new file mode 100644
index 0000000..0db8f1a
--- /dev/null
+++ b/tests/test_ui_admin_page.py
@@ -0,0 +1,171 @@
+"""Central de segurança (static/admin.html + admin.js): login, abas, laboratório PII e segurança do DOM.
+
+Recupera a cobertura dos testes antigos da interface administrativa (test_soc_ui,
+test_admin_frontend_operational, test_admin_page_route) para a central redesenhada.
+"""
+import re
+import typing
+from html.parser import HTMLParser
+from pathlib import Path
+
+from app.pii import PATTERNS
+from app.schemas import AuditIn
+
+ROOT = Path(__file__).resolve().parents[1]
+STATIC = ROOT / 'static'
+HTML = (STATIC / 'admin.html').read_text(encoding='utf-8')
+JS = (STATIC / 'admin.js').read_text(encoding='utf-8')
+TABS = ['overview', 'alerts', 'events', 'devices', 'lab']
+
+
+class Tree(HTMLParser):
+    def __init__(self):
+        super().__init__()
+        self.tags = []
+
+    def handle_starttag(self, tag, attrs):
+        self.tags.append((tag, dict(attrs)))
+
+    handle_startendtag = handle_starttag
+
+    def find(self, tag=None, **attrs):
+        return [a for t, a in self.tags if (tag is None or t == tag) and all(a.get(k) == v for k, v in attrs.items())]
+
+
+PAGE = Tree()
+PAGE.feed(HTML)
+IDS = [a['id'] for _, a in PAGE.tags if a.get('id')]
+
+
+def schema_sinks():
+    return list(typing.get_args(AuditIn.model_fields['sink'].annotation))
+
+
+def test_admin_route_serves_the_page_without_indexing(client):
+    page = client.get('/admin')
+    assert page.status_code == 200 and 'text/html' in page.headers['content-type']
+    assert 'name="robots" content="noindex"' in page.text
+    assert client.get('/api/v1/admin/overview').status_code == 401
+
+
+def test_login_fields_use_the_right_types_and_autocomplete():
+    email = PAGE.find('input', id='admin-email')[0]
+    password = PAGE.find('input', id='admin-pass')[0]
+    assert email['type'] == 'email' and email['autocomplete'] == 'username' and 'required' in email
+    assert password['type'] == 'password' and password['autocomplete'] == 'current-password' and 'required' in password
+    assert PAGE.find('button', type='submit')
+
+
+def test_login_explains_the_lockout_rule_shown_by_the_api():
+    assert '5 tentativas erradas em um minuto' in HTML and '60 segundos' in HTML
+
+
+def test_operational_area_starts_hidden_until_login():
+    assert PAGE.find('div', id='admin-section')[0]['class'] == 'hidden'
+    assert "$('admin-section').classList.remove('hidden')" in JS
+    assert "document.body.classList.add('admin-authenticated')" in JS
+
+
+def test_each_tab_controls_its_own_panel():
+    tabs = PAGE.find('button', role='tab')
+    assert [t['data-tab'] for t in tabs] == TABS
+    for tab in tabs:
+        panel = PAGE.find('section', id=tab['aria-controls'])
+        assert panel and panel[0]['role'] == 'tabpanel', tab
+        assert tab['id'] == f"tab-{tab['data-tab']}"
+    assert sum(t['aria-selected'] == 'true' for t in tabs) == 1
+
+
+def test_mobile_select_offers_the_same_areas_as_the_tabs():
+    select = HTML.split('id="admin-section-select"')[1].split('</select>')[0]
+    assert re.findall(r'value="([a-z]+)"', select) == TABS
+
+
+def test_shortcuts_only_point_to_existing_tabs():
+    targets = {a['data-go'] for _, a in PAGE.tags if 'data-go' in a}
+    assert targets and targets <= set(TABS)
+    assert "document.querySelectorAll('[data-go]')" in JS
+
+
+def test_keyboard_navigation_between_tabs():
+    for key in ('ArrowRight', 'ArrowLeft', 'Home', 'End'):
+        assert key in JS
+
+
+def test_tab_counters_are_filled_after_loading_operations():
+    for counter in ('tab-count-alerts', 'tab-count-devices'):
+        assert counter in IDS and f"$('{counter}')" in JS
+
+
+def test_session_email_is_shown_and_cleared_on_logout():
+    assert "$('session-email').textContent=$('admin-email').value" in JS
+    assert "$('session-email').textContent='admin'" in JS
+
+
+def test_logout_clears_data_and_restores_the_lab_placeholder():
+    logout = JS.split('function logout(')[1].split('\nfunction ')[0]
+    for cleared in ('event-list', 'soc-dossier', 'finding-list', 'device-list', 'attention-list'):
+        assert cleared in logout
+    assert 'auditPlaceholder();' in logout and "$('admin-pass').value = ''" in logout
+
+
+def test_lab_offers_exactly_the_sinks_accepted_by_the_api():
+    radios = PAGE.find('input', type='radio', name='audit-sink')
+    assert [r['value'] for r in radios] == schema_sinks()
+    assert sum('checked' in r for r in radios) == 1
+    assert "document.querySelector('input[name=\"audit-sink\"]:checked')" in JS
+
+
+def test_lab_labels_unsafe_and_control_sinks():
+    fieldset = HTML.split('class="ops-sinks"')[1].split('</fieldset>')[0]
+    assert fieldset.count('Inseguro') == 3 and fieldset.count('Controle') == 2
+
+
+def test_result_card_names_every_pii_type_the_detector_finds():
+    names = dict(re.findall(r"(\w+):'([^']+)'", JS.split('const PII_NAMES={')[1].split('};')[0]))
+    assert set(PATTERNS) <= set(names)
+
+
+def test_result_card_names_every_sink():
+    names = dict(re.findall(r"(\w+):'([^']+)'", JS.split('const SINKS={')[1].split('};')[0]))
+    assert list(names) == schema_sinks()
+
+
+def test_result_card_shows_flow_severity_action_preview_and_fix():
+    render = JS.split('function renderAudit(result){')[1].split('\n}\n')[0]
+    for part in ("'Entrada'", "'Proteção'", "'Destino'", "'Dados detectados'", "'Gravidade'", "'Ação'",
+                 "'Prévia guardada no servidor'", "'O que fazer'", 'result.redacted_preview', 'result.remediation'):
+        assert part in render, part
+    assert "'O texto original nunca é guardado.'" in render
+
+
+def test_dynamic_content_never_uses_innerhtml():
+    for source in (JS, (STATIC / 'dashboard.js').read_text(encoding='utf-8')):
+        assert 'innerHTML' not in source and 'insertAdjacentHTML' not in source and 'document.write' not in source
+
+
+def test_token_lives_only_in_memory():
+    assert 'localStorage' not in JS and 'sessionStorage' not in JS and 'document.cookie' not in JS
+    assert 'let token = null;' in JS
+
+
+def test_badges_use_sentence_case_instead_of_all_caps():
+    for old in ('EXEMPLO FICTÍCIO', 'CENÁRIO FICTÍCIO', 'COMPROMETIMENTO NÃO CONFIRMADO', 'SIMULAÇÃO'):
+        assert old not in JS
+    assert "badge('Fictício','demo')" in JS
+
+
+def test_resolving_an_event_requires_a_justification():
+    assert "note.length < 8" in JS and 'pelo menos oito caracteres' in JS
+
+
+def test_device_flow_diagram_documents_the_iot_limits():
+    figure = HTML.split('O caminho de uma leitura')[1].split('</svg>')[0]
+    for text in ('401 recusado', '429 bloqueado', 'Após 10 erros em 1 min', '201 · Leitura gravada'):
+        assert text in figure
+
+
+def test_admin_footer_has_the_lab_warning_and_area_links():
+    footer = HTML.split('<footer')[1]
+    assert 'Use só dados inventados no laboratório de privacidade.' in footer
+    assert footer.count('data-go=') == 5
diff --git a/tests/test_ui_data_contracts.py b/tests/test_ui_data_contracts.py
new file mode 100644
index 0000000..3575c83
--- /dev/null
+++ b/tests/test_ui_data_contracts.py
@@ -0,0 +1,140 @@
+"""Contratos entre a API e as telas: cada campo que dashboard.js e admin.js leem existe na
+resposta, inclusive nos modos de demonstração, e a origem dos dados é sempre declarada.
+
+Substitui test_ui_climate_provenance, test_history_frontend, test_city_comparison_charts,
+test_territory_data_connections e test_ui_home_and_assets do frontend anterior.
+"""
+import json
+import os
+import shutil
+import subprocess
+from datetime import date, timedelta
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+DASH = (ROOT / 'static' / 'dashboard.js').read_text(encoding='utf-8')
+PUBLIC = (ROOT / 'static' / 'index.html').read_text(encoding='utf-8')
+
+
+def auth(token):
+    return {'Authorization': f'Bearer {token}'}
+
+
+def test_public_page_is_served_with_a_strict_csp(client):
+    page = client.get('/')
+    assert page.status_code == 200 and 'text/html' in page.headers['content-type']
+    csp = page.headers['content-security-policy']
+    assert "frame-src https://www.openstreetmap.org" in csp and "frame-ancestors 'none'" in csp
+
+
+def test_demo_summary_has_both_stations_read_by_the_dashboard(client):
+    data = client.get('/api/v1/demo/summary').json()
+    for code in ('verde-demo', 'centro-demo'):
+        readings = data['readings'][code]
+        assert readings
+        assert {'temperature_c', 'humidity_pct', 'measured_at'} <= set(readings[-1])
+
+
+def test_station_readings_have_the_fields_of_the_comparison_chart(client):
+    summary = client.get('/api/v1/summary').json()
+    assert {'stations', 'readings_total'} <= set(summary)
+    assert {s['code'] for s in summary['stations']} >= {'verde-demo', 'centro-demo'}
+    client.post('/api/v1/stations/centro-demo/readings', json={'temperature_c': 33.1, 'humidity_pct': 50},
+                headers={'X-Device-Key': os.environ['SENSOR_A_KEY']})
+    rows = client.get('/api/v1/stations/centro-demo/readings?limit=24').json()
+    assert rows and {'temperature_c', 'humidity_pct', 'measured_at', 'simulated'} <= set(rows[-1])
+
+
+def test_demo_weather_has_the_fields_of_the_weather_card(client):
+    data = client.get('/api/v1/demo/weather').json()
+    assert {'temperature_c', 'apparent_temperature_c', 'humidity_pct'} <= set(data)
+    assert 'Exemplo fictício' in DASH
+
+
+@pytest.mark.parametrize('period', ['tarde', 'noite'])
+def test_heatmap_periods_return_a_grid_for_both_buttons(client, period):
+    data = client.get(f'/api/v1/heatmap/demo?period={period}').json()
+    points = data['grid']['points']
+    assert points and {'latitude', 'longitude', 'temperature_c'} <= set(points[0])
+    assert data.get('notice')
+
+
+def test_heatmap_rejects_periods_without_a_button(client):
+    assert client.get('/api/v1/heatmap/demo?period=madrugada').status_code == 422
+
+
+def test_demo_city_search_returns_what_the_result_buttons_show(client):
+    data = client.get('/api/v1/demo/places?search=Bar').json()
+    assert data['locations']
+    assert {'name', 'latitude', 'longitude'} <= set(data['locations'][0])
+
+
+def test_demo_history_has_the_series_and_summary_of_the_history_chart(client):
+    end = date.today() - timedelta(days=8)
+    start = end - timedelta(days=29)
+    data = client.get(f'/api/v1/demo/history?latitude=-23.53&longitude=-46.79&start_date={start}&end_date={end}').json()
+    assert len(data['days']) == 30
+    assert {'date', 'temperature_mean_c', 'temperature_min_c', 'temperature_max_c'} <= set(data['days'][0])
+    assert {'mean_temperature_c', 'highest_temperature_c', 'lowest_temperature_c', 'days_mean_above_30c'} <= set(data['summary'])
+
+
+def test_every_source_shown_to_the_user_is_labelled():
+    for label in ('reanálise ERA5', 'hipotética', 'Open-Meteo', 'NOAA', 'EPA', 'simuladas'):
+        assert label in PUBLIC
+    for label in ('Valores fictícios', 'série fictícia', 'SERIE FICTICIA', 'Busca offline'):
+        assert label in DASH
+
+
+def test_esp32_listing_has_the_fields_of_the_table(client):
+    assert client.get('/api/v1/medicoes?limit=60').status_code == 200
+    for field in ('medido_em', 'zona', 'temperatura', 'umidade', 'indice_calor', 'luminosidade', 'nivel_risco'):
+        assert f'r.{field}' in DASH or f'rows[0].{field}' in DASH
+
+
+def test_audit_response_feeds_the_result_card_for_unsafe_and_control_sinks(client, token):
+    for sink, blocked in (('log_bruto', True), ('banco_parametrizado', False)):
+        result = client.post('/api/v1/admin/audit', headers=auth(token),
+                             json={'sample_text': 'CPF: 000.000.000-00; email: exemplo@example.invalid', 'source': 'formulario', 'sink': sink}).json()
+        assert result['blocked'] is blocked and result['sink'] == sink
+        assert {'pii_types', 'severity', 'redacted_preview', 'remediation'} <= set(result)
+        assert '000.000.000-00' not in result['redacted_preview'] and 'exemplo@example.invalid' not in result['redacted_preview']
+
+
+def test_operations_feed_the_station_cards_and_counters(client, token):
+    data = client.get('/api/v1/admin/operations', headers=auth(token)).json()
+    assert {'failed_logins_24h', 'rejected_devices_24h', 'stale_real_stations', 'demo_events', 'demo_findings', 'stations', 'simulated_stations'} <= set(data['counts'])
+    station = data['stations'][0]
+    assert {'name', 'code', 'setting', 'simulated', 'status', 'latest', 'last_seen_at'} <= set(station)
+
+
+def test_alerts_have_every_field_shown_in_the_dossier(client, token):
+    assert client.post('/api/v1/admin/security/demo-scenario', headers=auth(token)).status_code in (200, 201)
+    alerts = client.get('/api/v1/admin/security/alerts?hours=168&status=all&include_demo=true', headers=auth(token)).json()['alerts']
+    assert alerts
+    needed = {'id', 'title', 'severity', 'status', 'category', 'created_at', 'observed', 'summary', 'hypothetical_impact',
+              'affected_asset', 'affected_status', 'next_steps', 'evidence_gaps', 'related_event_count', 'is_demo'}
+    assert needed <= set(alerts[0])
+
+
+def heat_index_js(t, rh):
+    source = DASH.split('function heatIndex(t, rh) {')[1].split('\nconst riskOf')[0]
+    script = ('const num = v => Number.isFinite(Number(v)) ? Number(v) : null;\n'
+              'function heatIndex(t, rh) {' + source + f'\nconsole.log(JSON.stringify(heatIndex({t}, {rh})));')
+    return json.loads(subprocess.run(['node', '-e', script], capture_output=True, text=True, check=True).stdout)
+
+
+def heat_index_py(t, rh):
+    T = t * 9 / 5 + 32
+    hi = 0.5 * (T + 61 + (T - 68) * 1.2 + rh * 0.094)
+    if (hi + T) / 2 >= 80:
+        hi = (-42.379 + 2.04901523 * T + 10.14333127 * rh - .22475541 * T * rh - .00683783 * T * T
+              - .05481717 * rh * rh + .00122874 * T * T * rh + .00085282 * T * rh * rh - .00000199 * T * T * rh * rh)
+    return (hi - 32) * 5 / 9
+
+
+@pytest.mark.skipif(shutil.which('node') is None, reason='Node.js não instalado')
+def test_dashboard_heat_index_matches_the_noaa_formula():
+    for t, rh in ((25.0, 60), (33.9, 48), (36.0, 40)):
+        assert abs(heat_index_js(t, rh) - heat_index_py(t, rh)) < 0.05
diff --git a/tests/test_ui_public_page.py b/tests/test_ui_public_page.py
new file mode 100644
index 0000000..23c60ce
--- /dev/null
+++ b/tests/test_ui_public_page.py
@@ -0,0 +1,200 @@
+"""Painel público (static/index.html): estrutura, navegação, acessibilidade e ligação com o dashboard.js.
+
+Substitui os testes do frontend antigo (atlas, sequência da floresta, navegação da home) pela
+mesma cobertura aplicada ao redesenho: cada seção existe, cada número exibido tem um elemento
+com id que o JavaScript preenche e cada imagem e link externo segue as regras de acessibilidade.
+"""
+import re
+from html.parser import HTMLParser
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+STATIC = ROOT / 'static'
+HTML = (STATIC / 'index.html').read_text(encoding='utf-8')
+DASH = (STATIC / 'dashboard.js').read_text(encoding='utf-8')
+
+
+class Tree(HTMLParser):
+    """Guarda cada tag de abertura com seus atributos, na ordem do documento."""
+
+    def __init__(self):
+        super().__init__()
+        self.tags = []
+
+    def handle_starttag(self, tag, attrs):
+        self.tags.append((tag, dict(attrs)))
+
+    handle_startendtag = handle_starttag
+
+    def find(self, tag=None, **attrs):
+        return [a for t, a in self.tags if (tag is None or t == tag) and all(a.get(k) == v for k, v in attrs.items())]
+
+    def ids(self):
+        return [a['id'] for _, a in self.tags if a.get('id')]
+
+
+PAGE = Tree()
+PAGE.feed(HTML)
+IDS = PAGE.ids()
+
+
+def section_order():
+    wanted = ('inicio', 'problema', 'como', 'esp32', 'mapa-calor', 'historico')
+    return [i for i in IDS if i in wanted]
+
+
+def test_sections_follow_the_reading_order_of_the_design():
+    assert section_order() == ['inicio', 'problema', 'como', 'esp32', 'mapa-calor', 'historico']
+
+
+def test_every_section_is_labelled_by_an_existing_heading():
+    sections = PAGE.find('section')
+    assert len(sections) >= 7
+    for attrs in sections:
+        label = attrs.get('aria-labelledby')
+        assert label, f'seção sem aria-labelledby: {attrs}'
+        assert label in IDS
+
+
+def test_page_has_a_single_h1_and_named_h2s():
+    assert HTML.count('<h1') == 1
+    assert len(re.findall(r'<h2[ >]', HTML)) >= 7
+
+
+def test_document_metadata_for_portuguese_and_mobile():
+    assert '<html lang="pt-BR">' in HTML
+    assert 'name="viewport" content="width=device-width, initial-scale=1"' in HTML
+    assert 'name="description"' in HTML and 'Osasco' in HTML
+    assert 'name="theme-color" content="#0F3D3A"' in HTML
+
+
+def test_header_and_footer_navigation_point_to_existing_sections():
+    hrefs = [a['href'] for a in PAGE.find('a') if a.get('href', '').startswith('#')]
+    assert len(hrefs) >= 12
+    for href in hrefs:
+        assert href[1:] in IDS, href
+
+
+def test_header_links_to_the_security_center_and_swagger_is_in_the_footer():
+    links = [a['href'] for a in PAGE.find('a')]
+    assert '/admin' in links and '/docs' in links
+
+
+def test_mobile_menu_button_controls_the_navigation():
+    button = PAGE.find('button', id='menu-toggle')[0]
+    assert button['aria-controls'] == 'site-navigation' and button['aria-expanded'] == 'false'
+    assert 'site-navigation' in IDS
+
+
+def test_live_strip_values_are_filled_by_the_dashboard():
+    for element in ('live-shade', 'live-sun', 'live-delta', 'live-risk', 'live-updated'):
+        assert element in IDS
+        assert f"$('{element}')" in DASH
+
+
+def test_headline_and_problem_numbers_come_from_the_readings():
+    for element in ('hero-delta', 'hero-updated', 'prob-shade', 'prob-sun', 'prob-over', 'temp-delta', 'delta-verdict'):
+        assert element in IDS and f"$('{element}')" in DASH
+    # A contagem de leituras acima do limite usa o mesmo limiar de ilha de calor do firmware.
+    assert 'temperature_c >= 3) over++' in DASH
+
+
+def test_four_steps_explain_the_pipeline_with_described_illustrations():
+    block = HTML.split('class="sv-steps"')[1].split('</ol>')[0]
+    assert block.count('<li>') == 4
+    assert block.count('role="img"') == 4 and block.count('aria-label="') == 4
+    for step in ('Etapa 1', 'Etapa 2', 'Etapa 3', 'Etapa 4'):
+        assert step in block
+
+
+def test_how_to_read_ruler_is_updated_with_the_real_values():
