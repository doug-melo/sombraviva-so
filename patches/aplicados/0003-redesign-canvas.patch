+.sv-steps p { font-size: 15px; line-height: 1.6; color: var(--ink-2); }
 
-.sv-table-wrap { margin-top: 18px; overflow-x: auto; border-radius: var(--radius-l); border: 1px solid var(--line); background: var(--paper); }
-.sv-table { width: 100%; border-collapse: collapse; font-size: .92rem; }
-.sv-table caption { text-align: left; padding: 14px 18px 6px; font: 600 1.1rem/1.2 var(--display); }
-.sv-table th, .sv-table td { padding: 10px 18px; text-align: left; border-bottom: 1px solid var(--line); white-space: nowrap; }
-.sv-table th { font-size: .8rem; color: var(--ink-soft); font-weight: 600; }
-.sv-table tbody tr:last-child td { border-bottom: 0; }
-.sv-pill { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: .8rem; font-weight: 600; color: #fff; }
-.sv-pill.risk-normal { background: var(--ok); } .sv-pill.risk-atencao { background: var(--warn); color: var(--ink); }
-.sv-pill.risk-alerta { background: var(--alert); } .sv-pill.risk-perigo { background: var(--danger); }
+/* Dados agora */
+.sv-howto { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; }
+.sv-howto svg { flex: 2 1 480px; min-width: 0; height: auto; }
+.sv-howto figcaption { flex: 1 1 260px; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
+.sv-howto figcaption strong { font-size: 17px; }
+.sv-howto figcaption span { font-size: 15px; line-height: 1.6; color: var(--ink-2); }
+.sv-row { display: flex; flex-wrap: wrap; gap: 24px; }
+.sv-chart-card { flex: 1 1 460px; display: flex; flex-direction: column; gap: 12px; }
+.sv-chart-card.is-wide { flex: 2 1 560px; }
+.sv-card-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; }
+.sv-legend .k-shade, .sv-legend .k-sun { width: 14px; height: 4px; border-radius: 2px; }
+.sv-legend .k-shade { background: var(--green-2); } .sv-legend .k-sun { background: var(--brick); }
+.sv-legend .k-limit { width: 26px; height: 0; border-radius: 0; border-top: 2px dashed var(--green); }
+.sv-chart-gauge { height: 260px; }
+.sv-scale { padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 10px; font-size: 13px; color: var(--ink-2); }
+.sv-scale li { display: flex; align-items: center; gap: 6px; }
+.sv-scale li::before { content: ""; width: 10px; height: 10px; border-radius: 3px; flex: none; }
+.sv-scale .r-normal::before { background: var(--green-3); } .sv-scale .r-atencao::before { background: var(--amber); }
+.sv-scale .r-alerta::before { background: var(--brick); } .sv-scale .r-perigo::before { background: var(--wine); }
+.sv-table-wrap { flex: 1 1 460px; padding: 0; overflow-x: auto; }
+.sv-table { width: 100%; min-width: 520px; border-collapse: collapse; font-size: 14px; }
+.sv-table caption { text-align: left; padding: 24px 24px 10px; font-weight: 700; font-size: 17px; }
+.sv-table th { text-align: left; color: var(--ink-3); font-size: 13px; font-weight: 500; padding: 8px 10px; }
+.sv-table td { padding: 10px; border-top: 1px solid var(--rule); }
+.sv-table th:first-child, .sv-table td:first-child { padding-left: 24px; }
+.sv-table th:last-child, .sv-table td:last-child { padding-right: 24px; }
 
-.sv-map-controls { display: flex; gap: 8px; margin-bottom: 12px; }
-.sv-chip { min-height: 40px; padding: 6px 16px; border-radius: 999px; border: 1px solid rgba(255,255,255,.4); background: transparent; color: #fff; font: 600 .9rem var(--text); cursor: pointer; }
-.sv-chip[aria-pressed="true"] { background: var(--t4); border-color: var(--t4); color: var(--asphalt); }
+/* Mapa */
+.sv-map { display: flex; flex-wrap: wrap; gap: 24px; align-items: stretch; }
+.sv-map-canvas { flex: 2 1 560px; min-width: 0; border-radius: 20px; overflow: hidden; background: #2A3034; padding: 12px; }
 .sv-chart-heatmap { height: 460px; }
+.sv-map-side { flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
+.sv-map-controls { display: flex; gap: 8px; }
+.sv-chip { flex: 1; font: inherit; font-size: 15px; font-weight: 700; min-height: 48px; border-radius: 12px; border: 1px solid #6A7276; background: transparent; color: var(--page); cursor: pointer; }
+.sv-chip[aria-pressed="true"] { background: var(--page); color: var(--ink); }
+.sv-map-orient { display: flex; flex-direction: column; gap: 8px; }
+.sv-map-orient img { width: 100%; border-radius: 14px; background: var(--page); }
+.sv-map-orient figcaption { font-size: 13px; color: #BFC6C9; }
+.sv-map-frame { border-radius: 14px; overflow: hidden; min-height: 220px; flex: 1; }
+.sv-map-frame iframe { width: 100%; height: 100%; min-height: 220px; border: 0; display: block; }
 
-.sv-form { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px 18px; align-items: start; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-l); padding: 18px 20px; }
-.sv-form > label:nth-child(1), .sv-form > label:nth-child(2) { grid-column: span 2; }
+/* Histórico */
+.sv-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; align-items: start; padding: 20px 24px; }
 .sv-search { display: flex; gap: 8px; }
-.sv-search input { flex: 1; }
-.sv-form-actions { grid-column: 1 / -1; display: flex; gap: 10px; flex-wrap: wrap; }
-.sv-results { grid-column: 1 / -1; list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
-.sv-results button { min-height: 40px; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--line); background: #fff; cursor: pointer; font: 500 .9rem var(--text); }
