From 6debbd0706517a59216ca9a3fc8b1ad47873e548 Mon Sep 17 00:00:00 2001
From: Douglas Melo <161658032+doug-melo@users.noreply.github.com>
Date: Wed, 18 Nov 2026 22:21:58 -0300
Subject: [PATCH] Rolagem suave do menu animada quadro a quadro
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

O smooth nativo (CSS e scrollIntoView) é desligado pelo navegador quando o
Windows está com os efeitos de animação desligados. Os links internos agora
animam a rolagem com requestAnimationFrame, param se o usuário rolar ou usar
o teclado e respeitam o scroll-padding-top.
---
 static/navigation.js         | 27 ++++++++++++++++++++++++---
 tests/test_ui_public_page.py |  3 ++-
 2 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/static/navigation.js b/static/navigation.js
index df929f1..6d213c5 100644
--- a/static/navigation.js
+++ b/static/navigation.js
@@ -1,13 +1,34 @@
 (() => {
   'use strict';
-  // Rolagem suave nos links internos (#secao), feita em JavaScript para funcionar em
-  // qualquer navegador; o foco vai para a seção, para quem navega pelo teclado.
+  // Rolagem suave nos links internos (#secao), animada aqui mesmo quadro a quadro.
+  // O "smooth" nativo (CSS ou scrollIntoView) é desligado pelo Chrome e pelo Firefox quando o
+  // Windows está com os efeitos de animação desligados; esta animação funciona sempre.
+  let frame = null;
+  const stop = () => { if (frame) cancelAnimationFrame(frame); frame = null; };
+  ['wheel', 'touchstart', 'keydown'].forEach(type => window.addEventListener(type, stop, {passive: true}));
+  const ease = t => (t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
+  function smoothTo(target) {
+    stop();
+    const offset = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
+    const start = window.scrollY;
+    const end = Math.max(0, target.getBoundingClientRect().top + start - offset);
+    const distance = end - start;
+    const duration = Math.min(1200, 450 + Math.abs(distance) * 0.18);
+    let begin = null;
+    const step = now => {
+      if (begin === null) begin = now;
+      const progress = Math.min(1, (now - begin) / duration);
+      window.scrollTo({top: start + distance * ease(progress), behavior: 'instant'});
+      frame = progress < 1 ? requestAnimationFrame(step) : null;
+    };
+    frame = requestAnimationFrame(step);
+  }
   document.querySelectorAll('a[href^="#"]').forEach(link => link.addEventListener('click', event => {
     const id = decodeURIComponent(link.getAttribute('href').slice(1));
     const target = id && document.getElementById(id);
     if (!target) return;
     event.preventDefault();
-    target.scrollIntoView({behavior: 'smooth', block: 'start'});
+    smoothTo(target);
     if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
     target.focus({preventScroll: true});
     history.pushState(null, '', '#' + id);
diff --git a/tests/test_ui_public_page.py b/tests/test_ui_public_page.py
index a7fcc6d..da68ea3 100644
--- a/tests/test_ui_public_page.py
+++ b/tests/test_ui_public_page.py
@@ -220,7 +220,8 @@ def test_motion_works_without_javascript_and_softens_with_reduced_motion():
 def test_internal_links_scroll_smoothly_and_move_focus():
     nav = (STATIC / 'navigation.js').read_text(encoding='utf-8')
     assert "querySelectorAll('a[href^=\"#\"]')" in nav
-    assert "scrollIntoView({behavior: 'smooth', block: 'start'})" in nav and 'target.focus({preventScroll: true})' in nav
+    assert 'requestAnimationFrame(step)' in nav and "behavior: 'instant'" in nav  # animação própria, não depende do SO
+    assert 'smoothTo(target);' in nav and 'target.focus({preventScroll: true})' in nav
     assert 'html { scroll-behavior: smooth;' in (STATIC / 'sv-base.css').read_text(encoding='utf-8')
 
 
