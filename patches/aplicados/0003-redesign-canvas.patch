-.sv-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0; margin: 18px 0 0; }
-.sv-summary div { padding: 10px 16px 10px 0; }
-.sv-summary dt { font-size: .82rem; color: var(--ink-soft); }
-.sv-summary dd { margin: 2px 0 0; font: 600 1.5rem/1.1 var(--display); }
+.sv-search .sv-button { padding: 0 14px; min-height: 48px; }
+.sv-form-actions { display: flex; gap: 10px; align-self: end; padding-bottom: 22px; }
+.sv-form-actions .sv-button { flex: 1; }
+.sv-results { grid-column: 1 / -1; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
+.sv-results:empty { display: none; }
+.sv-results button { font: inherit; font-size: 14px; min-height: 44px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--field); background: var(--paper); cursor: pointer; }
+.sv-results button:hover { border-color: var(--green); }
+.sv-chart-history { height: 340px; }
+.sv-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; }
+.sv-summary div { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 16px 18px; display: flex; flex-direction: column-reverse; gap: 4px; }
+.sv-summary dt { font-size: 13px; color: var(--ink-3); }
+.sv-summary dd { font-size: 26px; font-weight: 800; letter-spacing: -.6px; }
 
-.sv-sources { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 28px; }
-.sv-sources .sv-section-head { grid-column: 1 / -1; margin: 0; }
-.sv-source-list { margin: 0; display: grid; gap: 16px; }
-.sv-source-list dt { font: 600 1.1rem/1.2 var(--display); }
-.sv-source-list dd { margin: 4px 0 0; color: var(--ink-soft); max-width: 62ch; }
-.sv-map-frame { border-radius: var(--radius-l); overflow: hidden; border: 1px solid var(--line); min-height: 320px; }
-.sv-map-frame iframe { width: 100%; height: 100%; min-height: 320px; border: 0; display: block; }
