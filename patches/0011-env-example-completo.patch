From 6752eda6e0d761343246e16d0c85ffe9fdd64a02 Mon Sep 17 00:00:00 2001
From: Douglas Melo <161658032+doug-melo@users.noreply.github.com>
Date: Wed, 18 Nov 2026 22:39:20 -0300
Subject: [PATCH] =?UTF-8?q?.env.example=20completo:=20todas=20as=20vari?=
 =?UTF-8?q?=C3=A1veis=20da=20API,=20comentadas?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Inclui ESP32_DEVICE_ID/TOKEN, PANEL_DATA_SOURCE, a integração com a OpenAI
(OPENAI_API_KEY e OPENAI_MODEL, opcionais) e API_URL do simulador.
---
 .env.example | 66 +++++++++++++++++++++++++++++++++++++---------------
 1 file changed, 47 insertions(+), 19 deletions(-)

diff --git a/.env.example b/.env.example
index d7e2af5..421238f 100644
--- a/.env.example
+++ b/.env.example
@@ -1,38 +1,66 @@
-# Copie para .env e substitua todas as credenciais marcadas como SUBSTITUA.
-# MySQL LOCAL instalado no Windows/Linux: DB_HOST=127.0.0.1, DB_PORT=3306.
-# MySQL do Docker acessado pela API local: DB_HOST=127.0.0.1, DB_PORT=3307.
-# Em `docker compose up --build` DB_HOST/DB_PORT são ajustados no serviço da API.
+# =============================================================================
+#  SombraViva — variáveis de ambiente da API (SOA + Cybersecurity + IoT)
+#  Copie para .env e troque todo valor marcado como SUBSTITUA.
+#  Nunca envie o .env para o Git: ele guarda senhas e chaves reais.
+#  Na VM, use /etc/sombraviva/app.local.conf (mesmos nomes) em vez deste arquivo.
+# =============================================================================
+
+# --- Ambiente ---------------------------------------------------------------
+# development (sua máquina), vm (servidor Linux) ou test (só os testes automáticos)
+APP_ENV=development
+# Cria estações simuladas, leituras e casos fictícios da central. Desligue em produção.
+SEED_DEMO_DATA=true
+
+# --- Banco de dados MySQL ----------------------------------------------------
+# MySQL instalado na máquina (Windows/Linux): DB_HOST=127.0.0.1 e DB_PORT=3306.
+# MySQL do Docker acessado pela API rodando fora do Docker: DB_PORT=3307.
+# Com `docker compose up --build`, o compose já ajusta DB_HOST/DB_PORT da API.
 DB_HOST=127.0.0.1
 DB_PORT=3306
 DB_NAME=sombraviva
 DB_USER=sombraviva
 DB_PASSWORD=SUBSTITUA_POR_SENHA_FORTE_DO_MYSQL
-# Alternativa para MySQL remoto (opcional): descomente e substitua; prioridade sobre DB_*.
+# Opcional: MySQL remoto. Se preenchida, tem prioridade sobre as variáveis DB_*.
 # DATABASE_URL=mysql+pymysql://usuario:senha_url_encoded@host:3306/sombraviva?charset=utf8mb4
 
-# Somente Docker Compose: credencial do administrador do banco e porta exposta no host
+# Só para o Docker Compose: senha do root do MySQL e porta exposta no seu computador.
 MYSQL_ROOT_PASSWORD=SUBSTITUA_POR_SENHA_ROOT_DIFERENTE
 MYSQL_HOST_PORT=3307
 
-# Credenciais da aplicação (não comitar valores reais)
+# --- Segurança da aplicação (mínimo de 16 caracteres cada) ------------------
+# Assina os tokens de login da central. Trocar derruba as sessões abertas.
+# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
 JWT_SECRET=SUBSTITUA_POR_CHAVE_ALEATORIA_COM_32_CARACTERES_OU_MAIS
+# Administrador da central de segurança. A senha só é usada ao criar o usuário
+# pela primeira vez; depois disso, trocar aqui não muda a senha no banco.
 ADMIN_EMAIL=admin@sombraviva.local
 ADMIN_PASSWORD=SUBSTITUA_POR_SENHA_FORTE_ADMIN
+
+# --- Estações e dispositivos IoT --------------------------------------------
+# Chaves das estações cadastradas (fonte original do painel):
+# A = Calçadão exposto (centro-demo), B = zona arborizada (verde-demo).
+# Enviadas no cabeçalho X-Device-Key em POST /api/v1/stations/{code}/readings.
 SENSOR_A_KEY=SUBSTITUA_POR_CHAVE_SEGURA_SENSOR_A
 SENSOR_B_KEY=SUBSTITUA_POR_CHAVE_SEGURA_SENSOR_B
-
-# Opcional: tradução de achados PII e análise de alertas SOC por LLM.
-# A análise SOC só é chamada ao clicar, usa metadados e até seis chamadas/hora/admin (limite por processo).
-OPENAI_API_KEY=
-OPENAI_MODEL=gpt-4.1-mini
-
-# Dados acadêmicos de demonstração em MySQL (desabilite em produção).
-APP_ENV=development
-SEED_DEMO_DATA=true
-
-# ESP32 do Wokwi (POST /api/v1/medicoes). Sem token próprio, usa SENSOR_A_KEY.
+# ESP32 do Wokwi (POST /api/v1/medicoes com Authorization: Bearer + X-Device-Id).
+# Use os mesmos valores no sketch.ino. Vazio = a API usa o SENSOR_A_KEY como token do ESP32.
 ESP32_DEVICE_ID=esp32-osasco-calcadao-01
 ESP32_DEVICE_TOKEN=
 
-# Fonte inicial do painel público (depois a central troca): estacoes (original) ou esp32
+# --- Painel público ----------------------------------------------------------
+# Fonte inicial das leituras sombra x sol: estacoes (original) ou esp32.
+# Depois a central troca em Estações e IoT > Fonte dos dados do painel público.
 PANEL_DATA_SOURCE=estacoes
+
+# --- Inteligência artificial (OpenAI) -----------------------------------------
+# Usada na central para explicar achados do laboratório PII e analisar alertas.
+# Só é chamada quando o administrador clica no botão, com metadados (nunca o texto
+# bruto, PII ou segredos) e até seis análises por hora por administrador.
+# Deixe vazia para usar a orientação por regras locais, sem custo.
+# Chave em https://platform.openai.com/api-keys
+OPENAI_API_KEY=
+OPENAI_MODEL=gpt-4.1-mini
+
+# --- Scripts auxiliares --------------------------------------------------------
+# Endereço da API usado por scripts/simulate_iot.py para enviar leituras simuladas.
+API_URL=http://127.0.0.1:8000
-- 
