+.sv-ods-grid div { display: flex; flex-direction: column; gap: 12px; border-top: 4px solid; padding-top: 18px; }
+.sv-ods-grid span { font-size: 14px; font-weight: 700; }
+.sv-ods-grid p { font-size: 17px; line-height: 1.6; }
+.sv-ods-grid .ods-3 { border-color: #4C9F38; } .sv-ods-grid .ods-3 span { color: #3A7A2A; }
+.sv-ods-grid .ods-11 { border-color: #FD9D24; } .sv-ods-grid .ods-11 span { color: #A35E00; }
+.sv-ods-grid .ods-13 { border-color: #3F7E44; } .sv-ods-grid .ods-13 span { color: #3F7E44; }
 
