-/* === identidade-territorial.css === */
-/*
- * SombraViva — Atlas de Rua / revisão visual 2026.3
- * =================================================
- * Camada semântica de interface, aplicada sobre a base existente.
- * Mapeamento: lima=ação, coral=calor/alerta, menta=vegetação/IoT,
- * ciano=meteorologia regional, papel=arquivo/documentação.
- * Os IDs e contratos de JS permanecem inalterados.
- */
-:root{
- --sv-canvas:#071A1C;--sv-base:#102E2D;--sv-raised:#21433C;
- --sv-paper:#F4F1E7;--sv-paper-ink:#102E2D;
- --sv-body:#D1E2D9;--sv-white:#F4F1E7;--sv-lime:#D6FF4B;
- --sv-sensor:#55E6B2;--sv-heat:#FF856B;--sv-climate:#67D7E5;
- --sv-muted:#96AEA3;--sv-rule:#496960;
- --bg:var(--sv-canvas);--surface:var(--sv-base);--surface-up:var(--sv-raised);
- --text:var(--sv-white);--mint:var(--sv-sensor);--lime:var(--sv-lime);
- --coral:var(--sv-heat);--cyan:var(--sv-climate)
-}
-html{scroll-behavior:smooth}
-@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
-body{background:var(--sv-canvas);color:var(--sv-white);font-size:16px}
-:where(button,input,select,textarea){font-size:14px}
-:where(a,button,input,select,textarea,summary):focus-visible{outline:3px solid var(--sv-lime);outline-offset:3px}
-::selection{background:var(--sv-lime);color:var(--sv-canvas)}
-/* Navigation: human-readable labels are the primary cue, numbers secondary. */
-.sidebar{border-bottom-color:#44655c}
-.sidebar .navlink{min-height:44px;gap:7px}
-.sidebar .nav-ico{font-size:11px;opacity:.78}
-.sidebar .brand-name{letter-spacing:-.055em}
-.sidebar .brand-name small{letter-spacing:.075em;font-size:10px}
-.topbar{background:#0b2425}
-.topbar-breadcrumb{font-size:11px;letter-spacing:.075em}
-/* Cover: shift from software hero to an issue of a place-specific field journal. */
-body:not(.admin-body) .hero{grid-template-columns:minmax(0,1.02fr) minmax(0,.98fr);border-bottom:1px solid var(--sv-rule);align-items:stretch}
-body:not(.admin-body) .hero-copy{padding:clamp(42px,5vw,74px) clamp(24px,3.2vw,56px) clamp(40px,4.4vw,62px) clamp(24px,3.6vw,62px)}
-body:not(.admin-body) .hero h1{font-family:Baskerville,"Iowan Old Style",Georgia,serif;font-weight:450;font-size:clamp(47px,5.65vw,88px);line-height:1.01;letter-spacing:-.055em;max-width:12ch}
-body:not(.admin-body) .hero h1 em{color:var(--sv-lime)}
-body:not(.admin-body) .hero h1 span{font-size:.48em;line-height:1.15;color:var(--sv-white);max-width:22ch}
