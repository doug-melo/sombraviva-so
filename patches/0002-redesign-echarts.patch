-body:not(.admin-body) .panel-heading .eyebrow{font-size:11px;letter-spacing:.095em;color:#b9d6c9}
-body:not(.admin-body) .panel-heading h2{font-size:clamp(28px,2.5vw,42px);line-height:1.1}
