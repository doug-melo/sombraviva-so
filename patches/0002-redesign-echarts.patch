-body:not(.admin-body) .hero-overline{font-size:11px;letter-spacing:.08em;color:#d2e4ca}
-body:not(.admin-body) .hero-overline .eyebrow-number{letter-spacing:.03em}
-body:not(.admin-body) .hero-graphic.photo-hero{min-height:550px;position:relative;background:#174139}
