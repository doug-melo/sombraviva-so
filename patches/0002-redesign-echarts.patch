-/* === editorial-natureza.css === */
-/* SombraViva 2026 — Editorial Natureza. Scoped composition layer.
-   A visual-only integration of the approved prototype: no endpoint, ID contract or sample data is replaced.
-   Originals remain under atlas-claro.css; this layer owns the public brand surfaces only.
-*/
-:root{
-  --sv-ed-paper:#F9F9F4;
-  --sv-ed-ink:#113B30;
-  --sv-ed-text:#234D41;
-  --sv-ed-line:#C5D3C7;
-  --sv-ed-leaf:#417854;
-  --sv-ed-lemon:#D5EB90;
-  --sv-ed-clay:#BF533E;
-  --sv-ed-mist:#EFF3E9;
-}
-body:not(.admin-body){background:var(--sv-ed-paper);color:var(--sv-ed-ink)}
-body:not(.admin-body) .sidebar{background:var(--sv-ed-paper);border-bottom-color:var(--sv-ed-line)}
-body:not(.admin-body) .sidebar .brand-name{font:800 clamp(24px,2.1vw,31px)/.95 'Inter Display','Inter',Arial,sans-serif;letter-spacing:-.065em}
-body:not(.admin-body) .sidebar .brand-name small{font-size:10px;font-weight:600;letter-spacing:.055em;margin-top:7px}
-body:not(.admin-body) .sidebar .header-api{background:transparent;color:var(--sv-ed-ink);border:1px solid var(--sv-ed-ink);border-radius:100px;padding-inline:19px}
-body:not(.admin-body) .sidebar .header-api:hover{background:var(--sv-ed-ink);color:white}
-body:not(.admin-body) .topbar{background:var(--sv-ed-mist)!important;border-color:var(--sv-ed-line)}
-body:not(.admin-body) .layout main{max-width:1750px;padding-inline:clamp(18px,4vw,76px);padding-top:0}
-.sv-editorial-hero{background:var(--sv-ed-paper);padding:0;border:0;margin:0 0 44px}
-.sv-editorial-cover{max-width:100%;margin:0 auto}
-.sv-editorial-headline{display:grid;grid-template-columns:minmax(0,1.85fr) minmax(270px,.65fr);gap:clamp(20px,3vw,45px);align-items:start;padding-block:clamp(36px,4.5vw,72px) 32px}
-.sv-editorial-headline h1{font:850 clamp(62px,8.6vw,152px)/.82 'Inter Display','Inter',Arial,sans-serif;letter-spacing:-.072em;color:var(--sv-ed-ink);margin:0;max-width:950px;overflow-wrap:normal}
-.sv-editorial-headline h1 span{display:block;font-size:.72em;letter-spacing:-.072em;font-weight:570;margin-top:12px}
-.sv-editorial-intro{display:flex;flex-direction:column;align-items:flex-start;gap:22px;padding:5px 0 0;min-width:0}
-.sv-location{font-size:12px;font-weight:800;letter-spacing:.085em;text-transform:uppercase;color:var(--sv-ed-ink)}
-.sv-editorial-intro p{color:var(--sv-ed-text);font-size:clamp(15px,1.4vw,18px);line-height:1.65;max-width:33ch;margin:0}
-.sv-editorial-actions{display:flex;flex-wrap:wrap;align-items:center;gap:14px}
-.sv-action-primary,.sv-action-secondary{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:10px 19px;border-radius:28px;font-size:14px;font-weight:750;text-decoration:none;white-space:normal}
